{
  // `npx wrangler deploy` puts your own copy on <name>.<you>.workers.dev, free.
  "name": "hum",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Encrypted library sync is optional. To turn it on for your copy, create a database,
  // add a block like the one under env.production with your own database_id, then:
  //   npx wrangler d1 migrations apply hum-sync --remote
  // Without it the app still works and offers export and import instead.
  // The official site: `npx wrangler deploy --env production`
  "env": {
    "production": {
      "name": "hum",
      "assets": { "directory": "./public", "binding": "ASSETS" },
      "routes": [{ "pattern": "hum.anzalabidi.dev", "custom_domain": true }],
      // Environments do not inherit bindings, so the sync database is declared again.
      "d1_databases": [{ "binding": "SYNC", "database_name": "hum-sync", "database_id": "a3da76f6-6ab3-4a00-8b2d-9444402cacee", "migrations_dir": "migrations" }]
    }
  }
}
